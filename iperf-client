#!/bin/bash
exec >iperf-client-stderrout.txt
exec 2>&1

. /usr/bin/iperf-base || (echo "/usr/bin/iperf-base not found"; exit 1)

dump_runtime
validate_label
validate_sw_prereqs jq ss iperf3 getopt ip

# defaults
ifname=""
protocol=""
length=""
time=10
hunt_probe_time=8
# K=1 by default: a single full-duration confirm. K>1 (bidirectional reclaim)
# is only useful when hunting a sharp, real loss cliff AND is unsafe for
# multi-pair scale-out -- a variable confirm count and jitter-driven winner
# selection desynchronize each pair's winning window, collapsing the benchmark's
# shared measurement period to zero. Keep K=1 unless single-pair on a real cliff.
hunt_confirm_attempts=1
bit_rate=None
remotehost=""
control_port=""
data_port=""
cpu_pin=""
pt_opts=""
ipv="4"
bstart=0
bend=0
bitrate_range=
max_loss_pct=0
omit=0
num_peers=0
nthreads=1

echo "opts before: $@"
longopts="ipv:,ifname:,protocol:,length:,remotehost:,time:,bitrate:,cpu-pin:,passthru:,bitrate-range:,max-loss-pct:,omit:,num-peers:,nthreads:,hunt-probe-time:,hunt-confirm-attempts:"
opts=$(getopt -q -o "" --longoptions "$longopts" -n "getopt.sh" -- "$@");
if [ $? -ne 0 ]; then
    exit_error "Unrecognized option specified"
fi
eval set -- "$opts";
echo "opts after: $@"
while true; do
    case "$1" in
        --ipv)
            shift;
            ipv="$1"
            echo "ipv=$ipv"
            shift
            ;;
        --ifname)
            shift;
            ifname="$1"
            echo "ifname=$ifname"
            shift
            ;;
	    --cpu-pin)
	        shift;
	        cpu_pin=$1
	        echo "cpu_pin=${cpu_pin}"
	        shift;
	        ;;
        --protocol)
            shift;
            if [ "$1" == "udp" ]; then
                protocol="--udp"
            fi
            echo "protocol=$protocol"
            shift
            ;;
        --length)
            shift;
            length="--length $1"
            echo "length=$length"
            shift
            ;;
        --bitrate)
            shift;
            bit_rate=$1
            echo "bitrate=$bit_rate"
            shift
            ;;
        --max-loss-pct)
            shift;
            max_loss_pct=$1
            echo "max-loss-pct=$max_loss_pct"
            shift
            ;;
        --remotehost)
            shift;
            remotehost=$1
            echo "remotehost=$remotehost"
            shift
            ;;
        --time)
            shift;
            time=$1
            echo "time=$time"
            shift
            ;;
        --passthru)     # iperf options that user wants passthru
            shift;
            pt_opts=$1
            echo "pt_opts=$pt_opts"
            shift
            ;;
        --bitrate-range)     # iperf zero-drop hunt 
            shift;
            bitrate_range=$1
            echo "bitrate-range=$bitrate_range"
            bstart=$(echo $bitrate_range | awk -F'-' '{print $1}')
            bend=$(echo $bitrate_range | awk -F'-' '{print $2}')
            shift
            ;;
        --omit)     # skip first number of seconds
            shift;
            omit=$1
            echo "omit=$omit"
            shift
            ;;
        --num-peers)     # number of siblings for IRQ pinning
            shift;
            num_peers=$1
            echo "num-peers=$num_peers"
            shift
            ;;
        --nthreads)     # number of parallel iperf3 streams (-P), one OS thread per stream since iperf3 3.16
            shift;
            nthreads=$1
            echo "nthreads=$nthreads"
            shift
            ;;
        --hunt-probe-time)
            shift;
            hunt_probe_time=$1
            echo "hunt-probe-time=$hunt_probe_time"
            shift
            ;;
        --hunt-confirm-attempts)
            shift;
            hunt_confirm_attempts=$1
            echo "hunt-confirm-attempts=$hunt_confirm_attempts"
            shift
            ;;
        --)
            shift;
            break
            ;;
        *)
            exit_error "Invalid option: $1"
    esac
done

# IRQ pinning if num_peers is specified
if [ "$num_peers" -gt 0 ]; then
    # Check if this is a physical/VF interface (not veth)
    if [ -e "/sys/class/net/$ifname/device/msi_irqs" ]; then
        echo "Calling run_iperf_worker with num_peers=$num_peers and ifname=$ifname"
        export IFACE="$ifname"
        run_iperf_worker "$num_peers"
    else
        echo "INFO: Skipping IRQ pinning for $ifname (not a physical/VF interface, likely veth in OVN-K)"
    fi
fi

# Split off an optional parameter after a ':', used by "cpu:<list>" (an
# explicit CPU list/range) and "cpu-numa:<N>" (auto-pick N CPUs from the
# interface's numa node).
cpu_pin_param=""
if echo "${cpu_pin}" | grep -q "^cpu:"; then
    cpu_pin_param=$(echo "${cpu_pin}" | cut -d: -f2-)
    cpu_pin="cpu"
elif echo "${cpu_pin}" | grep -q "^cpu-numa:"; then
    cpu_pin_param=$(echo "${cpu_pin}" | cut -d: -f2-)
    cpu_pin="cpu-numa-n"
fi

case "${cpu_pin}" in
    ""|"numa"|"cpu-numa"|"cpu"|"cpu-numa-n")
	;;
    *)
	exit_error "unsupported cpu-pin value '${cpu_pin}'"
	;;
esac

uname -a
# Unless the user specifies a specific remotehost argument, this must
# be sourced from the endpoint (which gets it from the client)
if [ -z "$remotehost" ]; then
    echo "--remotehost was not set via cmdline args, checking for resolved service info"
    echo "These files exist in ./msgs/rx:"
    /bin/ls -l msgs/rx
    file="msgs/rx/svc"
    if [ -e "$file" ]; then
        echo "Found resolved service info: ${file}"
        ipaddr=`jq -r '.svc.ip' $file`
        if [ ! -z "$ipaddr" ]; then
            echo "Found server IP $ipaddr"
            remotehost=$ipaddr
        fi
        port=`jq -r '.svc.ports[0]' $file`
        if [ ! -z "$port" ]; then
            echo "Found server control port $port"
            control_port=$port
        fi
        port=`jq -r '.svc.ports[1]' $file`
        if [ ! -z "$port" ]; then
            echo "Found server data port $port"
            data_port=$port
        fi
    else
        echo "Did not find $file, so cannot get an IP from the server/endpoint"
    fi
fi

# Confirm we have a remotehost (server) and ports
if [ -z "$remotehost" ]; then
    exit_error "remotehost is not set"
fi
# TODO: validate $remotehost with regex

#
# The cpu_pin="cpu-numa" mode, pin client and server to a CPU.
# If they colocate (INTRA-xxx), they should also be on the same NUMA.
#
ifname=$(ip route get ${remotehost} | head -n 1 | awk -F" dev " '{ print $2 }' | awk -F" src " '{ print $1 }')
if [ ! -e /sys/class/net/${ifname} ]; then
    exit_error "invalid interface '${ifname}' found"
fi

ifname_numa_node=
ifname_numa_node_cpus=
ifname_numa_node_lookup=${ifname}
# A VLAN (or other stacked virtual interface, e.g. a VLAN on top of a
# bond) has no "device" of its own in sysfs -- walk the lower_<iface>
# symlink(s) sysfs exposes for stacked interfaces until we reach a
# physical interface with a numa_node file, or run out of lower
# interfaces to follow.
while [ ! -e /sys/class/net/${ifname_numa_node_lookup}/device/numa_node ]; do
    found_lower=""
    for lower_path in /sys/class/net/${ifname_numa_node_lookup}/lower_*; do
        if [ -e "${lower_path}" ]; then
            lower_iface=${lower_path##*/}
            ifname_numa_node_lookup=${lower_iface#lower_}
            found_lower=1
            break
        fi
    done
    if [ -z "${found_lower}" ]; then
        break
    fi
done
if [ -e /sys/class/net/${ifname_numa_node_lookup}/device/numa_node ]; then
    ifname_numa_node=$(cat /sys/class/net/${ifname_numa_node_lookup}/device/numa_node)
    if [ "$ifname_numa_node" == "-1" ]; then
        if [[ "${cpu_pin}" == "numa" || "${cpu_pin}" == "cpu-numa" || "${cpu_pin}" == "cpu-numa-n" ]]; then
            exit_error "PCIe has no NUMA locality, but cpu-pin is ${cpu_pin}"
        fi
        # VM case, use numa 0
        ifname_numa_node=0
    fi
elif [[ "${cpu_pin}" == "numa" || "${cpu_pin}" == "cpu-numa" || "${cpu_pin}" == "cpu-numa-n" ]]; then
    exit_error "cannot determine numa node for interface '${ifname}' and cpu-pin is ${cpu_pin}"
else
    # If there is no numa associated with ifname, just use numa 0.
    ifname_numa_node=0
fi

ifname_numa_node_cpus=$(cat /sys/devices/system/node/node${ifname_numa_node}/cpulist)
# convert to comma separated list if there are ranges i.e 0-5 items
ifname_numa_node_cpus=$(echo $ifname_numa_node_cpus | perl -pe 's/(\d+)-(\d+)/join(",",$1..$2)/eg')
echo "ifname=${ifname}"
echo "ifname_numa_node=${ifname_numa_node}"
echo "ifname_numa_node_cpus=${ifname_numa_node_cpus}"


# These ports should come from the endpoint, but if for some
# reason they don't the default port numbers are calculated
# in this way:
if [ -z "$control_port" ]; then
    let "control_port = 2 * $id"
    let "control_port = $control_port + 30000"
    echo "control_port was not set, using default of $control_port"
fi
if [ -z "$data_port" ]; then
    let "data_port = $control_port + 1"
    echo "data_port was not set, using default of $data_port"
fi
echo "ifname=${ifname}"
echo "ifname_numa_node=${ifname_numa_node}"
echo "remotehost=$remotehost"
echo "control_port=$control_port"
echo "data_port=$data_port"
echo "time=$time"
echo "length=$length"
echo "protocol=$protocol"
cpu_pin_cmd=""
case "${cpu_pin}" in
    "numa")
        cpu_pin_cmd="taskset --cpu-list ${ifname_numa_node_cpus}"
        ;;
    "cpu-numa")
        assign-pin-cpu client ${ifname_numa_node_cpus}
        ;;
    "cpu-numa-n")
        # Auto-pick cpu_pin_param CPUs from the interface's numa node. iperf3
        # has no native per-thread affinity (esnet/iperf#1738 is still open),
        # so this pins the whole process to a CPU range and lets the kernel
        # scheduler spread the nthreads streams across it.
        available=$(echo "${ifname_numa_node_cpus}" | tr ',' '\n' | wc -l)
        requested="${cpu_pin_param}"
        if [ "${requested}" -gt "${available}" ]; then
            echo "WARNING: cpu-pin requested ${requested} cpus but numa node ${ifname_numa_node} only has ${available}; clamping to ${available}"
            requested="${available}"
        fi
        pool=$(echo "${ifname_numa_node_cpus}" | tr ',' '\n' | head -n "${requested}" | paste -sd, -)
        cpu_pin_cmd="taskset --cpu-list ${pool}"
        ;;
    "cpu")
        cpu_pin_cmd="taskset --cpu-list ${cpu_pin_param}"
        ;;
esac

options="--format k -c $remotehost -p $control_port $protocol $length"
if [ "$omit" -ne 0 ]; then
    options+=" --omit $omit"
fi
if [ "$nthreads" -gt 1 ]; then
    options+=" --parallel $nthreads"
fi

#options+=" --cport $data_port"
# strip ',' from the passthru options 
passthru_opts=$(echo "$pt_opts" | sed 's/,/ /g')

options+=" $passthru_opts"

time_opt="-t $time"
# If passthru has --time or -t, let it override our $time value
for p in ${passthru_opts}; do
    if echo "$p" | grep -Eq '\-t[0-9]|\-\-time'; then
        echo "passthru $p overrides time=$time"
        time_opt=""
        break
    fi
done

options+=" $time_opt"

if [ $bit_rate != None ]; then
    options+=" --bitrate $bit_rate"
fi
cmd+="${cpu_pin_cmd} iperf3 $options"
if [ "$ipv" == "6" ]; then
    cmd+=" -6"
fi
echo "going to run: ${cmd}"

if [ "$bitrate_range" != "" ]; then
    # We are in a hunting run
    source /usr/bin/iperf-hunter
    echo "Hunting for zero drop"
    #extract the last char, the unit i.e KMG
    unit=$(echo ${bstart: -1})
    bstart=${bstart::-1}
    bend=${bend::-1}

    probe_cmd=$(echo "$cmd" | sed "s/-t [0-9]*/-t $hunt_probe_time/")
    if [ "$probe_cmd" == "$cmd" ]; then
        # sed found no "-t <n>" to shorten (e.g. --time was supplied via
        # passthru). Warn rather than silently running probes at full duration.
        echo "WARNING: could not shorten probe duration (no '-t <n>' in cmd); probes will run at full --time"
    fi
    export cmd probe_cmd hunt_phase conn hunt_final hunt_pinfail

    echo "HUNTING begin:" > iperf-client-result.txt
    generic-hunter --begin $bstart --end $bend  --max-loss-pct $max_loss_pct iperf-drop-hunter $unit

    cp iperf-client-result.txt iperf-hunt-probes.txt

    #
    # Confirm phase: bracketed bisection at FULL duration, bounded to
    # $hunt_confirm_attempts runs. It moves toward whichever side it needs:
    #   - on PASS: record as the pass floor (lo). If a fail ceiling (hi) is
    #     known, bisect up toward it; otherwise (first attempt passed) reclaim
    #     upward by re-testing hunt_pinfail at full duration -- the rate a noisy
    #     short-probe false-DROP would have wrongly rejected.
    #   - on FAIL: record as the fail ceiling (hi) and bisect down toward the
    #     known pass floor (lo), or toward bstart if none yet.
    # Every attempt emits a full-duration BEGIN-TS/PASS-or-FAIL block; the
    # post-processor already selects the highest-bitrate PASS, so the best
    # confirmed rate wins with no post-processor changes.
    #
    hunt_phase="confirm"
    export hunt_phase
    lo=""                       # highest full-duration PASS rate
    hi=""                       # lowest full-duration FAIL rate
    confirm_rate=$hunt_final
    confirm_attempts=0

    while [ $confirm_attempts -lt $hunt_confirm_attempts ]; do
        confirm_attempts=$((confirm_attempts+1))
        echo "Confirm attempt $confirm_attempts/$hunt_confirm_attempts at ${confirm_rate}${unit} (lo=${lo:-none} hi=${hi:-none})"
        if iperf-drop-hunter $unit $confirm_rate; then
            echo "Confirm PASSED at ${confirm_rate}${unit}"
            lo=$confirm_rate
            if [ -n "$hi" ]; then
                # bracket known on both sides: bisect up toward the ceiling
                next=$(( ($lo + $hi) / 2 ))
            elif [ "$lo" -lt "$hunt_pinfail" ]; then
                # reclaim: jump up to the rate that capped the probe search
                next=$hunt_pinfail
            else
                # already at/above the search cap and still passing: keep
                # climbing toward the range top to recover an earlier false-DROP
                next=$(( ($lo + $bend) / 2 ))
            fi
        else
            echo "Confirm FAILED at ${confirm_rate}${unit}"
            hi=$confirm_rate
            if [ -n "$lo" ]; then
                next=$(( ($lo + $hi) / 2 ))
            else
                next=$(( ($bstart + $hi) / 2 ))
            fi
        fi

        # stop when the bracket has converged or the next rate repeats
        if [ -n "$lo" ] && [ "$next" -le "$lo" ]; then
            break
        fi
        if [ "$next" -eq "$confirm_rate" ]; then
            break
        fi
        confirm_rate=$next
    done

    if [ -n "$lo" ]; then
        echo "Confirm phase done; highest full-duration PASS = ${lo}${unit}"
    else
        echo "WARNING: All confirm attempts failed, using last full-duration FAIL block"
    fi
    exit
fi

timeout_sec=10
interval=1
elapsed=0
start_time=$SECONDS

until (echo >/dev/tcp/$remotehost/$control_port) &>/dev/null; do
    elapsed=$((SECONDS - start_time))
    if [ $elapsed -ge $timeout_sec ]; then
        echo "ERROR: $remotehost:$control_port unreachable after ${timeout_sec}s"
        exit 1
    fi
    echo "Waiting for $remotehost:$control_port... (${elapsed}s)"
    sleep $interval
done

# Sleep remaining time so all parallel pods start together
elapsed=$((SECONDS - start_time))
remaining=$((timeout_sec - elapsed))
if [ $remaining -gt 0 ]; then
    echo "$remotehost:$control_port is ready, waiting ${remaining}s for other pods..."
    sleep $remaining
fi

echo "Starting iperf3..."

echo BEGIN-TS-0 $(date +%s.%N) > iperf-client-result.txt
${cmd} 2>&1 >> iperf-client-result.txt
iperf_rc=$?
echo END-TS-0 $(date +%s.%N) >> iperf-client-result.txt
if [ $iperf_rc -gt 0 ]; then
    iperf_errors=`grep -i error iperf-client-result.txt`
    exit_error "$iperf_errors"
fi
