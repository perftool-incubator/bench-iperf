{
    "workshop": {
        "schema": {
            "version": "2020.03.02"
        }
    },
    "userenvs": [
        {
            "name": "default",
            "requirements": [
                "iperf_src",
                "debug"
            ]
        }
    ],
    "requirements": [
        {
            "name": "debug",
            "type": "distro",
            "distro_info": {
                "packages": [
                    "ethtool",
                    "net-tools",
                    "tcpdump"
                ]
            }
        },
        {
            "name": "iperf_src",
            "type": "source",
            "source_info": {
                "url": "https://github.com/atheurer/iperf/archive/refs/heads/udp-fanout.tar.gz",
                "filename": "iperf.tar.gz",
                "commands": {
                    "unpack": "tar -xzf iperf.tar.gz",
                    "get_dir": "tar -tzf iperf.tar.gz | head -n 1",
                    "commands": [
                        "./configure --disable-shared",
                        "make",
                        "make install",
                        "ldconfig",
                        "/usr/local/bin/iperf3 -v"
                    ]
                }
            }
        }
    ]
}