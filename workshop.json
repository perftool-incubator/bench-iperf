{
    "workshop": {
        "schema": {
            "version": "2020.03.02"
        }
    },
    "userenvs": [
	    {
	        "name": "default",
	        "requirements": [
                "iperf_src",
                "debug"
	        ]
	    }
    ],
    "requirements": [
        {
            "name": "debug",
            "type": "distro",
            "distro_info": {
                "packages": [
                    "ethtool",
                    "net-tools",
                    "tcpdump"
                ]
            }
        },
	    {
	        "name": "iperf_src",
	        "type": "source",
	        "source_info": {
		        "url": "https://github.com/atheurer/iperf.git",
		        "branch": "udp-fanout",
		        "commands": {
		            "commands": [
			            "./configure --disable-shared",
			            "make",
			            "make install",
			            "ldconfig",
			            "/usr/local/bin/iperf3 -v"
		            ]
                }
	        }
        }
    ]
}
